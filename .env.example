# KV Bench physical-node environment template.
#
# Copy this file to .env and fill machine-specific values.
# Keep .env local; it is intentionally ignored by git.

# Machines and network path.
A_IP=""
B_IP=""
A_IFACE=""
B_IFACE=""

# SSH is orchestration only. Ray, vLLM, and Redis use the private IPs above.
REMOTE_USER=""
REMOTE_HOST=""
SSH_PORT=""
REMOTE_ROOT=""

# Public service ports.
PORT="8001"
REDIS_PORT="6379"
GCS_PORT="6378"
MIN_WORKER_PORT="10002"
MAX_WORKER_PORT="10100"

# Model/runtime knobs that affect benchmark meaning.
MODEL=""
DTYPE="float16"
VLLM_GPU_MEMORY_UTILIZATION="0.96"
VLLM_EXTRA_ARGS="--enforce-eager --attention-backend TRITON_ATTN --language-model-only --mm-processor-cache-gb 0 --max-num-seqs 4"

# Track A: independent replicas with optional Redis KV sharing.
TRACK_A_PLAN="proof,matrix"
TRACK_A_PROOF_REQUESTS="80"
TRACK_A_MATRIX_REQUESTS="300"
TRACK_A_PREFIX_TOKENS="3000"
TRACK_A_MAX_TOKENS="1"

# Track B: distributed vLLM run.
# pp2      = TP=1, PP=2 across A+B
# tp2      = TP=2, PP=1 across A+B
# single_a = TP=1, PP=1 on A only
TRACK_B_CASES="pp2"
TRACK_B_REQUESTS="256"
TRACK_B_CONCURRENCY="4"
TRACK_B_PREFIX_TOKENS="2048"
TRACK_B_MAX_TOKENS="1"
TRACK_B_MAX_MODEL_LEN="4096"
